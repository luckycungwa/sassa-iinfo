# Canonical site URL. No trailing slash. Use the production domain when deploying.
# APP_URL: The URL where this site is hosted.
APP_URL="https://www.sassagranthub.co.za"

# Google Search Console verification token (the content value of the meta tag).
GOOGLE_SITE_VERIFICATION=""

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=""

# Google AdSense — publisher ID in the form ca-pub-XXXXXXXXXXXXXXXX.
# Leave blank until the account is approved. Ad units stay disabled without it.
NEXT_PUBLIC_ADSENSE_ID=""

# AdSense ad slot IDs (numeric, from the AdSense dashboard). An ad unit only
# renders when its slot ID is a real number; leave blank before approval.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_LEADERBOARD=""
NEXT_PUBLIC_ADSENSE_SLOT_GRANTS_HUB=""
NEXT_PUBLIC_ADSENSE_SLOT_STATUS_HUB=""
NEXT_PUBLIC_ADSENSE_SLOT_PAYMENT_DATES_HUB=""
NEXT_PUBLIC_ADSENSE_SLOT_APPEALS_HUB=""

