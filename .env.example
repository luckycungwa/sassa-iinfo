# PageAgent Configuration
# page-agent uses an OpenAI-compatible API. Configure your LLM provider below.
NEXT_PUBLIC_PAGE_AGENT_MODEL="qwen3.5-plus"
NEXT_PUBLIC_PAGE_AGENT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# Server-side only — never expose to client
PAGE_AGENT_API_KEY="your_api_key_here"
PAGE_AGENT_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# APP_URL: The URL where this site is hosted.
APP_URL="http://localhost:3000"
